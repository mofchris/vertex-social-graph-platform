# Copy to deploy/.env on the server and fill in. deploy/.env is git-ignored; never commit it.
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env

# Signs and verifies access tokens across all services. 64 random characters:
#   openssl rand -hex 32
APP_JWT_SECRET=

# Postgres password for the `vertex` role. Only read when the database is first created.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Token for the Cloudflare Tunnel connector (Zero Trust > Networks > Tunnels > vertex > the
# install command contains it after `--token`).
TUNNEL_TOKEN=
